{
  "name": "lantern",
  "productName": "Lantern",
  "version": "0.1.0",
  "private": true,
  "description": "A friendly desktop companion for Git Flow",
  "author": "Lantern",
  "license": "MIT",
  "main": "dist/main/main/main.js",
  "scripts": {
    "icons": "electron scripts/build-icons.cjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "smoke": "npm run build && electron tests/smoke.cjs",
    "premake": "node scripts/check-node.cjs",
    "prepackage": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^41.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
